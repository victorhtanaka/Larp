{
  "name": "larp",
  "productName": "Larp",
  "version": "0.6.4",
  "description": "Chat privado de voz e compartilhamento de tela para Windows",
  "main": ".vite/build/main.cjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/victorhtanaka/Larp.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/database.test.ts tests/profile-validation.test.ts tests/supabase-groups.test.ts tests/protocol.test.ts tests/quality.test.ts tests/presentation.test.ts tests/media-session.test.ts tests/notifications.test.ts tests/remote-audio-participants.test.ts tests/voice-activity.test.ts tests/presence.test.ts",
    "test:supabase": "tsx tests/supabase.integration.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
